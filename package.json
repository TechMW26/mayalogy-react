{
  "name": "mayalogy-react",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "sync:runtime-env": "node scripts/sync-runtime-env.mjs",
    "sync:vercel-env": "node scripts/vercel-env-sync.mjs",
    "predev": "node scripts/sync-runtime-env.mjs development",
    "dev": "vite",
    "prebuild": "node scripts/sync-runtime-env.mjs production",
    "build": "vite build",
    "preview": "vite preview",
    "dev:vercel": "vercel dev",
    "test:otp": "node --test tests/firebase-otp.test.js",
    "test:ui": "node --test tests/internal-ui.test.js",
    "test:ai": "node --test tests/pollinations-ai.test.js tests/review-login.test.js",
    "test:journey": "node --test tests/prelogin-journey.test.js",
    "test:notifications": "node --test tests/notifications.test.js",
    "test": "npm run test:otp && npm run test:ui && npm run test:ai && npm run test:journey && npm run test:notifications"
  },
  "dependencies": {
    "astronomy-engine": "^2.1.19",
    "firebase": "12.17.1",
    "firebase-admin": "13.10.0",
    "framer-motion": "^10.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "firebase-tools": "^15.15.0",
    "vite": "^7.3.5"
  }
}
