{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    { "source": "/textures/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }] }
  ],
  "functions": {
    "api/*.js": { "maxDuration": 30 }
  }
}