<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MAYAAstrology" parent="Theme.Material3.Dark.NoActionBar">
        
        <item name="colorPrimary">@color/maya_primary</item>
        <item name="colorPrimaryDark">@color/maya_primary_dark</item>
        <item name="colorAccent">@color/maya_accent</item>
        
        
        <item name="android:statusBarColor">#0b0b0c</item>
        <item name="android:navigationBarColor">#0b0b0c</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        
        
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:fitsSystemWindows">true</item>
        
        
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        
        
        <item name="android:windowBackground">#0b0b0c</item>
        
        
        <item name="colorSurface">@color/background_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnPrimary">@color/white</item>
    </style>
</resources>