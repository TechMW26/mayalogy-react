<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.MAYAAstrology" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Primary colors -->
        <item name="colorPrimary">@color/maya_primary</item>
        <item name="colorPrimaryDark">@color/maya_primary_dark</item>
        <item name="colorAccent">@color/maya_accent</item>
        
        <!-- System bars - Match app background (NOT fullscreen/edge-to-edge) -->
        <item name="android:statusBarColor">#0b0b0c</item>
        <item name="android:navigationBarColor">#0b0b0c</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
        
        <!-- System bar handling -->
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:fitsSystemWindows">true</item>
        <!-- Handle display cutouts on notched phones (API 27+) -->
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="27">shortEdges</item>
        
        <!-- Window background - same as web app -->
        <item name="android:windowBackground">#0b0b0c</item>
        
        <!-- Material3 colors -->
        <item name="colorSurface">@color/background_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnPrimary">@color/white</item>
    </style>
    
    <!-- Splash Theme - Pure black for seamless splash screen -->
    <style name="Theme.MAYAAstrology.Splash" parent="Theme.MAYAAstrology">
        <item name="android:windowBackground">#0b0b0c</item>
        <item name="android:statusBarColor">#0b0b0c</item>
        <item name="android:navigationBarColor">#0b0b0c</item>
    </style>
</resources>
